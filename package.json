{
  "name": "spendtally",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first PWA that tracks medical bills against your Medicaid spend-down, month by month.",
  "license": "GPL-3.0-or-later",
  "author": "Joel Stain Lobo",
  "homepage": "https://github.com/lobojoel2003/Spendtally#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobojoel2003/Spendtally.git"
  },
  "bugs": {
    "url": "https://github.com/lobojoel2003/Spendtally/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "prepare:ocr": "node scripts/copy-ocr-assets.mjs",
    "predev": "npm run prepare:ocr",
    "dev": "vite",
    "prebuild": "npm run prepare:ocr",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate:rules": "node scripts/validate-rules.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "npm run lint && npm run typecheck && npm run validate:rules && npm test",
    "version": "node scripts/check-version.mjs && git add CHANGELOG.md",
    "release:notes": "node scripts/release-notes.mjs",
    "fixtures": "node scripts/render-fixture.mjs",
    "docs:states": "node scripts/states-table.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "@tesseract.js-data/eng": "^1.0.0",
    "idb": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "preact": "^11.2.0",
    "tesseract.js": "^7.0.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
